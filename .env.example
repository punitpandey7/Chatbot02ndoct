# Copy to .env and fill in. .env is gitignored -- never commit keys.

# Primary LLM key (Phase 6 generation). Free: https://console.groq.com/keys
GROQ_API_KEY=

# Optional alternates (unused unless you change src/generate.py)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional model override. Check what your key can actually call:
#   python -m src.pipeline  (reports the error)  or list via the Groq console.
# Other chat models seen working on Groq: openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b
