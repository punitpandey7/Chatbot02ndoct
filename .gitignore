# --- secrets: never commit ---
.env
.env.*
!.env.example

# --- environments ---
.venv/
venv/
env/

# --- python bytecode / caches ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- vector store ---
# COMMITTED ON PURPOSE (~4.6 MB).
# Streamlit Community Cloud runs no build step, so there is nowhere to run
# `python -m src.ingest`. Committing the built index is what lets the app
# start without re-embedding, which is the one invariant we do not break.
# Rebuild and re-commit after changing sources or the chunking settings:
#     python -m src.ingest --rebuild
# data/chroma/

# --- sentence-transformers / HuggingFace model cache ---
# Rebuilt automatically on first run; ~90 MB of weights.
data/.hf_cache/

# --- streamlit local config ---
.streamlit/secrets.toml

# --- os / editor noise ---
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
