# Keep the build context small and stop host artefacts leaking into the image.
.venv/
venv/
__pycache__/
*.py[cod]
.git/
.gitignore

# Rebuilt inside the image by `python -m src.ingest`; never copy a host-built
# SQLite/HNSW index (architecture-specific, and it would mask a broken build).
data/chroma/

# Generated artefacts - regenerated by the build step.
data/embeddings.txt
data/retrieval_last.txt
data/chroma_status.txt

# Secrets. GROQ_API_KEY is injected as a Space secret at runtime, never baked in.
.env
.env.*
!.env.example

# Editor / OS noise
.vscode/
.idea/
*.log
.DS_Store
Thumbs.db