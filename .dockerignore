# Keep the build context small and stop host artefacts leaking into the image.
.venv/
venv/
__pycache__/
*.py[cod]
.git/
.gitignore

# NOTE: data/chroma/ is deliberately NOT ignored. The vector index is committed
# to the repo (~4.6 MB) precisely because the deployment target runs no build
# step, so there is nowhere else for it to come from. Excluding it here would
# leave the image without an index and fail its own startup check.

# Model weights: downloaded on first run, not carried from the host.
data/.hf_cache/

# Generated inspection artefacts.
data/embeddings.txt
data/retrieval_last.txt
data/chroma_status.txt

# Secrets. GROQ_API_KEY is injected at runtime from the host's secret store or
# .env, never baked into the image.
.env
.env.*
!.env.example

# Editor / OS noise
.vscode/
.idea/
*.log
.DS_Store
Thumbs.db